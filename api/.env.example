DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require
API_TITLE=SportApp V2
API_ENV=dev

# Odds-API.io — match odds ingest (app.ingest.odds_api)
ODDS_API_KEY=

# The Odds API — NFL game odds ingest (app.ingest.nfl_odds)
THE_ODDS_API_KEY=

# livetennisapi.com — match/fixture ingest (app.ingest.livetennis)
# Tier gates which endpoints are available: completed results and H2H need basic+.
LIVETENNIS_API_KEY=
LIVETENNIS_TIER=free

# Shared secret for admin routes (sent as the X-API-Key header).
# Leave empty for local use; set it before exposing the API beyond localhost.
ADMIN_API_KEY=
