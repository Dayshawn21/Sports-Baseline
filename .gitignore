# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
dist/
.pytest_cache/

# Env
api/.env
.env

# Logs — ingest output has carried API keys in request URLs
api/logs/
*.log

# Alembic
api/alembic.ini

# Node
web/node_modules/
web/dist/
web/.env

# Build output — regenerated by `npm run build`
web/build/
web/tsconfig.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Models (large binaries — copy manually)
api/models/*.json
api/models/*.joblib

# ...except the bundle metadata, which is a few KB of text and is load-bearing.
# ModelRegistry reads meta.json for the training-row floor and for whether the bundle
# was trained with NaN or zero fill. Without it the floor cannot be applied, so a
# checkout would happily serve the 217-row v5 bundle, and inference would fall back to
# zero-fill against a model trained on NaN.
!api/models/*_meta.json

# Training exports regenerate from the database in seconds (train_model.py --export-only)
# and run to several MB, so they are not worth versioning. tennis_training_v5.csv predates
# this rule and stays tracked; git only ignores files it is not already following.
api/models/tennis_training_*.csv

# Valuebetennis season CSVs for the 26c backtest, downloaded once by hand (CC BY 4.0).
api/data/valuebetennis/

# Immutable source files and manifests for candidate tennis ELO (41b).
api/data/tennismylife-elo/

# Playwright MCP writes snapshots and screenshots here during manual UI checks.
.playwright-mcp/

# Per-machine Claude Code settings (can hold local connection strings)
.claude/settings.local.json

# Scratch output
output/
tmp_*.json
.venv-*/

# Per-machine editor and plugin hook settings
.vscode/
.github/hooks/

# First-person interview coaching; kept local so it never reaches the public repo (37e).
docs/SportApp-Employer-Interview-Guide.md

# Analysis workspace (46a): exported charts and locally cached public data.
analysis/output/
analysis/data/
.ipynb_checkpoints/
